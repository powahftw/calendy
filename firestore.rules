rules_version = '2';

// Calendy stores configuration only. Calendar events are read live from the
// Google Calendar API and cached in the browser - they are never written here.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isThrottled() {
      return resource != null
        && resource.data.updatedAt is timestamp
        && request.time < resource.data.updatedAt + duration.value(500, 'ms');
    }

    function validCalendarSelection() {
      return request.resource.data.calendarSelection is map
        && request.resource.data.calendarSelection.keys().hasOnly(['calendarId', 'calendarSummary', 'accountEmail'])
        && request.resource.data.calendarSelection.calendarId is string
        && request.resource.data.calendarSelection.calendarId.size() > 0
        && request.resource.data.calendarSelection.calendarId.size() <= 500
        && (
          !request.resource.data.calendarSelection.keys().hasAny(['calendarSummary'])
          || (
            request.resource.data.calendarSelection.calendarSummary is string
            && request.resource.data.calendarSelection.calendarSummary.size() <= 500
          )
        )
        && (
          !request.resource.data.calendarSelection.keys().hasAny(['accountEmail'])
          || (
            request.resource.data.calendarSelection.accountEmail is string
            && request.resource.data.calendarSelection.accountEmail.size() <= 500
          )
        );
    }

    function validSettingsDocument() {
      return request.resource.data.keys().hasOnly([
        'theme',
        'highlightToday',
        'showWeekends',
        'showDayProgress',
        'weekdayAlign',
        'pillForAllTimedEvents',
        'year',
        'startMonth',
        'monthsToShow',
        'calendarSelection',
        'updatedAt'
      ])
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['theme']) || request.resource.data.theme is string)
        && (!request.resource.data.keys().hasAny(['highlightToday']) || request.resource.data.highlightToday is bool)
        && (!request.resource.data.keys().hasAny(['showWeekends']) || request.resource.data.showWeekends is bool)
        && (!request.resource.data.keys().hasAny(['showDayProgress']) || request.resource.data.showDayProgress is bool)
        && (!request.resource.data.keys().hasAny(['weekdayAlign']) || request.resource.data.weekdayAlign is bool)
        && (!request.resource.data.keys().hasAny(['pillForAllTimedEvents']) || request.resource.data.pillForAllTimedEvents is bool)
        && (
          !request.resource.data.keys().hasAny(['year'])
          || (request.resource.data.year is int && request.resource.data.year >= 2000 && request.resource.data.year <= 2100)
        )
        && (
          !request.resource.data.keys().hasAny(['startMonth'])
          || (request.resource.data.startMonth is int && request.resource.data.startMonth >= 0 && request.resource.data.startMonth <= 11)
        )
        && (
          !request.resource.data.keys().hasAny(['monthsToShow'])
          || (request.resource.data.monthsToShow is int && request.resource.data.monthsToShow in [3, 6, 12])
        )
        && (
          !request.resource.data.keys().hasAny(['calendarSelection'])
          || validCalendarSelection()
        );
    }

    match /users/{userId}/data/{docId} {
      allow read, delete: if isOwner(userId) && docId == 'settings';
      allow create: if isOwner(userId) && docId == 'settings' && validSettingsDocument();
      allow update: if isOwner(userId)
        && docId == 'settings'
        && !isThrottled()
        && validSettingsDocument();
    }
  }
}
